{
  "name": "intelligent-api-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent API Monitoring & Alert System",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm start --prefix backend\" \"npm run dev --prefix frontend\"",
    "test": "npm test --prefix backend",
    "test:coverage": "npm run test:coverage --prefix backend",
    "ingest": "npm run ingest --prefix backend",
    "streamlit": "streamlit run streamlit_app.py",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
